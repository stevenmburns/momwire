#!/bin/sh
# momwire-nec42-sinusoidal-linux: momwire's sinusoidal engine for EZNEC's and
# SimNEC's NEC-4.2 slot, no Python (momwire#1607), `momwire-nec42-sinusoidal`'s
# twin. A PREVIEW. Runs the build beside it that this CPU runs, the way
# momwire's own accelerator chooses (momwire._accel): avx2 on a CPU with
# AVX2 and FMA, sse2 on any other x86-64 CPU. MOMWIRE_FORCE_VARIANT=avx2 or
# sse2 overrides the choice; any other value is ignored.
here=$(dirname -- "$(readlink -f -- "$0")")
case "${MOMWIRE_FORCE_VARIANT:-}" in
avx2 | sse2) variant=$MOMWIRE_FORCE_VARIANT ;;
*)
    variant=sse2
    flags=$(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null)
    case " $flags " in
    *" avx2 "*) case " $flags " in *" fma "*) variant=avx2 ;; esac ;;
    esac
    ;;
esac
exec "$here/momwire-nec42-sinusoidal-linux-$variant" "$@"
